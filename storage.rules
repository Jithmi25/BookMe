rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // NIC documents: owner can read/write their own; admin can also read
    // for verification (checked via the admin custom claim — the same
    // claim gate used everywhere else, never a Firestore field). Without
    // this, /admin/verifications would have no way to actually display the
    // uploaded NIC image/PDF for review.
    match /nic-documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }
  }
}
